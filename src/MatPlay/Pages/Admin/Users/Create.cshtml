@page "/admin/users/create"
@model MatPlay.Pages.Admin.Users.CreateModel
@using MatPlay.Pages.Shared.Controls
@{
    ViewData["Title"] = "Neuer Benutzer";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Administration", null), ("Benutzer", "/admin/users"), ("Neu", null) };
}

@if (Model.Error != null)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form" novalidate>
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" for="Username">Benutzername <span class="mat-req" aria-hidden="true">*</span></label>
                    <input asp-for="Username" class="mat-input" required minlength="3" maxlength="40" autocomplete="off" data-msg-required="Bitte gib einen Benutzernamen ein." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="DisplayName">Anzeigename</label>
                    <input asp-for="DisplayName" class="mat-input" maxlength="60" autocomplete="off" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Password">Passwort <span class="mat-req" aria-hidden="true">*</span></label>
                    <input asp-for="Password" type="password" class="mat-input" required minlength="6" autocomplete="new-password" data-msg-required="Bitte lege ein Passwort fest." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Role">Rolle</label>
                    <select asp-for="Role" class="mat-select">
                        <option value="@Roles.User">User</option>
                        <option value="@Roles.Admin">Admin</option>
                    </select>
                </div>
            </div>
            <partial name="Controls/_FormActions" model="@(new FormActionsModel { BackUrl = "/admin/users" })" />
        </form>
    </div>
</div>
