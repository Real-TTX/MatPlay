@page "/admin/users/edit/{id:long}"
@model MatPlay.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Benutzer bearbeiten";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Administration", null), ("Benutzer", "/admin/users"), (Model.Target?.Username ?? "Bearbeiten", null) };
}

@if (Model.Error != null)
{
    <div class="alert alert-error">@Model.Error</div>
}

<form method="post" class="form">
    <div class="form-grid">
        <label class="form-field">
            <span>Benutzername</span>
            <input value="@Model.Target?.Username" disabled />
        </label>
        <label class="form-field">
            <span>Anzeigename</span>
            <input asp-for="DisplayName" maxlength="60" />
        </label>
        <label class="form-field">
            <span>Rolle</span>
            <select asp-for="Role">
                <option value="@Roles.User">User</option>
                <option value="@Roles.Admin">Admin</option>
            </select>
        </label>
        <label class="form-field">
            <span>Neues Passwort (leer = unverändert)</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        </label>
    </div>
    <div class="action-bar">
        <button type="submit" class="btn btn-primary">💾 Speichern</button>
        <a class="btn btn-secondary" href="/admin/users">‹ Zurück</a>
        <span class="action-gap"></span>
        <button type="submit" asp-page-handler="delete" class="btn btn-danger"
                onclick="return confirm('Diesen Benutzer wirklich löschen?')">🗑 Löschen</button>
    </div>
</form>
