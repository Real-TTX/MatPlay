@page "/admin/users/edit/{id:long}"
@model MatPlay.Pages.Admin.Users.EditModel
@using MatPlay.Pages.Shared.Controls
@{
    ViewData["Title"] = "Benutzer bearbeiten";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Administration", null), ("Benutzer", "/admin/users"), (Model.Target?.Username ?? "Bearbeiten", null) };
}

@if (Model.Error != null)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form" novalidate>
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" for="username-ro">Benutzername</label>
                    <input class="mat-input" id="username-ro" value="@Model.Target?.Username" disabled />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="DisplayName">Anzeigename</label>
                    <input asp-for="DisplayName" class="mat-input" maxlength="60" autocomplete="off" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Role">Rolle</label>
                    <select asp-for="Role" class="mat-select">
                        <option value="@Roles.User">User</option>
                        <option value="@Roles.Admin">Admin</option>
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="NewPassword">Neues Passwort</label>
                    <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" />
                    <span class="mat-hint">Leer lassen, um das Passwort nicht zu ändern.</span>
                </div>
            </div>
            <partial name="Controls/_FormActions" model="@(new FormActionsModel
            {
                BackUrl = "/admin/users",
                DeleteHandler = "Delete",
                DeleteConfirm = "Diesen Benutzer wirklich löschen?",
            })" />
        </form>
        <partial name="Controls/_DeleteForm" model="@(new FormActionsModel { DeleteHandler = "Delete" })" />
    </div>
</div>
