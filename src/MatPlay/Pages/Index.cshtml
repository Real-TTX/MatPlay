@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Start";
}

<section class="dash-section">
    <div class="dash-section-head">
        <h3>🎮 Aktive Spiele</h3>
        <a class="dash-link" href="/games">Alle Spiele ›</a>
    </div>

    @if (Model.ActiveGames.Count == 0)
    {
        <div class="dash-empty">
            <p>Gerade läuft kein Spiel – Zeit für eine neue Runde! 🎲</p>
            <a class="btn btn-primary" href="/games/new">＋ Neues Spiel starten</a>
        </div>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in Model.ActiveGames)
            {
                var module = ModuleRegistry.GetModule(game.ModuleKey);
                <a class="game-card" href="/play/@game.ShareToken">
                    <span class="game-card-icon">@(module?.Icon ?? "🎮")</span>
                    <span class="game-card-body">
                        <span class="game-card-name">@game.Name</span>
                        <span class="game-card-meta">@(module?.Name ?? game.ModuleKey) · @game.UpdateDate.ToLocalTime().ToString("dd.MM. HH:mm")</span>
                    </span>
                    <span class="badge badge-live">Läuft</span>
                </a>
            }
        </div>
    }
</section>

<section class="dash-section">
    <div class="dash-section-head">
        <h3>🚀 Spiel starten</h3>
        @if (Model.HasAnyGames)
        {
            <span class="dash-hint">Deine zuletzt gespielten Spielarten</span>
        }
    </div>
    <div class="preset-grid">
        @foreach (var preset in Model.TopPresets)
        {
            <div class="preset-card accent-@preset.Accent">
                <a class="preset-link" href="/games/create?preset=@preset.Key">
                    <span class="preset-icon">@preset.Icon</span>
                    <span class="preset-name">@preset.Name</span>
                    <span class="preset-desc">@preset.Description</span>
                    <span class="preset-cta">Starten ›</span>
                </a>
            </div>
        }
        <div class="preset-card accent-cyan preset-card-all">
            <a class="preset-link" href="/games/new">
                <span class="preset-icon">🗂</span>
                <span class="preset-name">Alle anzeigen</span>
                <span class="preset-desc">Der komplette Katalog mit Suche und Favoriten.</span>
                <span class="preset-cta">Zum Katalog ›</span>
            </a>
        </div>
    </div>
</section>
