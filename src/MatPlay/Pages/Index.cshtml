@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Start";
    ViewData["Description"] = "Deine laufenden Spiele und ein schneller Einstieg in die nächste Runde.";
}

<section class="mat-stack" aria-labelledby="active-title">
    <div class="mat-row mat-row--between">
        <h2 class="mp-h2" id="active-title">Aktive Spiele</h2>
        <a class="mp-more" href="/games">Alle Spiele @Ui.Icon("chevron-right")</a>
    </div>

    @if (Model.ActiveGames.Count == 0)
    {
        <div class="mat-card">
            <div class="mat-empty">
                <div class="mat-empty__icon">@Ui.Icon("gamepad")</div>
                <p class="mat-empty__title">Gerade läuft kein Spiel.</p>
                <a class="mat-btn mat-btn--primary" href="/games/new">@Ui.Icon("plus")<span>Neues Spiel starten</span></a>
            </div>
        </div>
    }
    else
    {
        <div class="mat-grid">
            @foreach (var game in Model.ActiveGames)
            {
                var module = ModuleRegistry.GetModule(game.ModuleKey);
                <a class="mat-card mp-game-card" href="/play/@game.ShareToken">
                    <span class="mp-cover" aria-hidden="true">@ModuleRegistry.IconFor(game.ModuleKey, game.PresetKey)</span>
                    <span class="mp-game-card__body">
                        <strong class="mat-truncate">@game.Name</strong>
                        <span class="mat-muted mat-small mat-truncate">@(module?.Name ?? game.ModuleKey) · @game.UpdateDate.ToLocalTime().ToString("dd.MM. HH:mm")</span>
                    </span>
                    <span class="mat-pill mat-pill--ok">Läuft</span>
                </a>
            }
        </div>
    }
</section>

<section class="mat-stack" aria-labelledby="start-title">
    <div class="mat-row mat-row--between">
        <h2 class="mp-h2" id="start-title">Spiel starten</h2>
        @if (Model.HasAnyGames)
        {
            <span class="mat-muted mat-small">Deine zuletzt gespielten Spielarten</span>
        }
    </div>
    <div class="mat-grid">
        @foreach (var preset in Model.TopPresets)
        {
            <a class="mat-card mp-preset" href="/games/create?preset=@preset.Key">
                <span class="mp-cover mp-cover--lg" aria-hidden="true">@preset.Icon</span>
                <strong>@preset.Name</strong>
                <span class="mat-muted mp-preset__desc">@preset.Description</span>
                <span class="mp-cta">Starten @Ui.Icon("arrow-right")</span>
            </a>
        }
        <a class="mat-card mp-preset" href="/games/new">
            <span class="mp-cover mp-cover--lg" aria-hidden="true">@Ui.Icon("grid")</span>
            <strong>Alle anzeigen</strong>
            <span class="mat-muted mp-preset__desc">Der komplette Katalog mit Suche und Favoriten.</span>
            <span class="mp-cta">Zum Katalog @Ui.Icon("arrow-right")</span>
        </a>
    </div>
</section>
