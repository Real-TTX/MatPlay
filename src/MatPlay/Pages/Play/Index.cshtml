@page "/play/{token}"
@model MatPlay.Pages.Play.IndexModel
@{
    ViewData["Title"] = Model.Game!.Name;
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Meine Spiele", "/games"), (Model.Game.Name, null) };
}

<div class="mp-play-bar">
    <span class="mat-pill mat-pill--plain">@Model.Module!.Name</span>
    <span class="mat-pill mat-pill--plain" id="statusBadge">…</span>
    <span class="mp-play-bar__spacer"></span>
    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="shareBtn" title="Link teilen">@Ui.Icon("link")<span class="mp-lbl">Teilen</span></button>
    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="wakeLockBtn" title="Bildschirm anlassen">@Ui.Icon("smartphone")<span class="mp-lbl">Display an</span></button>
    @if (Model.HelpPreset != null)
    {
        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="rulesBtn" title="Kurzregeln anzeigen" aria-controls="rulesPanel" aria-expanded="false">@Ui.Icon("help-circle")<span class="mp-lbl">Hilfe</span></button>
    }
    @if (Model.IsOwner)
    {
        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="finishBtn" title="Spiel beenden bzw. fortsetzen">@Ui.Icon("stop")<span class="mp-lbl">Beenden</span></button>
        <a class="mat-btn mat-btn--secondary mat-btn--sm mat-btn--icon" href="/games/edit/@Model.Game.Id" title="Bearbeiten" aria-label="Spiel bearbeiten">@Ui.Icon("edit")</a>
    }
</div>

@if (Model.HelpPreset != null)
{
    <section class="mat-card mp-rules" id="rulesPanel" hidden aria-label="Kurzregeln">
        <div class="mat-card__head"><h2 class="mat-card__title">Kurzregeln: @Model.HelpPreset.Name</h2></div>
        <div class="mat-card__body">
            <ul>
                @foreach (var rule in Model.HelpPreset.Rules)
                {
                    <li>@rule</li>
                }
            </ul>
        </div>
    </section>
}

<div class="mp-pin" id="pinBar" hidden></div>

<div id="playRoot"
     data-token="@Model.Game.ShareToken"
     data-module="@Model.Game.ModuleKey">
    <partial name="@Model.Module.PlayPartial" />
</div>

@section Scripts {
    <script src="~/js/play-core.js" asp-append-version="true"></script>
    <script src="~/js/play-@(Model.Game.ModuleKey).js" asp-append-version="true"></script>
}
