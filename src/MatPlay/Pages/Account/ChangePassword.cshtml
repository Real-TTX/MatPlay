@page "/account/change-password"
@model MatPlay.Pages.Account.ChangePasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Passwort ändern";
}

@if (Model.Forced)
{
    <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<span>Willkommen! Bitte lege zuerst ein neues Passwort fest, bevor es losgeht.</span></div>
}
@if (Model.Error != null)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<form method="post" class="mat-form" novalidate>
    <div class="mat-field">
        <label class="mat-label" for="NewPassword">Neues Passwort</label>
        <input asp-for="NewPassword" type="password" class="mat-input" required minlength="6" autofocus autocomplete="new-password" data-msg-required="Bitte lege ein Passwort fest." />
        <span class="mat-error" aria-live="polite"></span>
    </div>
    <div class="mat-field">
        <label class="mat-label" for="PasswordRepeat">Passwort wiederholen</label>
        <input asp-for="PasswordRepeat" type="password" class="mat-input" required autocomplete="new-password" data-msg-required="Bitte wiederhole das Passwort." />
        <span class="mat-error" aria-live="polite"></span>
    </div>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Passwort speichern</span></button>
        @if (!Model.Forced)
        {
            <a class="mat-btn mat-btn--secondary" href="/">@Ui.Icon("back")<span>Zurück</span></a>
        }
    </div>
</form>
@if (Model.Forced)
{
    <p class="mat-muted mat-small mp-auth-hint">Danach kannst du unter Administration → Benutzer weitere Konten anlegen.</p>
}
