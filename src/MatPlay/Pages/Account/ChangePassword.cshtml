@page "/account/change-password"
@model MatPlay.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Passwort ändern";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Passwort ändern", null) };
}

<div class="auth-card">
    @if (Model.Forced)
    {
        <div class="alert alert-info">
            👋 Willkommen! Bitte lege zuerst ein neues Passwort fest, bevor es losgeht.
        </div>
    }
    @if (Model.Error != null)
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form">
        <label class="form-field">
            <span>Neues Passwort</span>
            <input asp-for="NewPassword" type="password" required minlength="6" autofocus autocomplete="new-password" />
        </label>
        <label class="form-field">
            <span>Passwort wiederholen</span>
            <input asp-for="PasswordRepeat" type="password" required autocomplete="new-password" />
        </label>
        <div class="action-bar">
            <button type="submit" class="btn btn-primary">💾 Passwort speichern</button>
            @if (!Model.Forced)
            {
                <a class="btn btn-secondary" href="/">‹ Zurück</a>
            }
        </div>
    </form>
    @if (Model.Forced)
    {
        <p class="form-hint">Danach kannst du unter Administration → Benutzer weitere Konten anlegen.</p>
    }
</div>
