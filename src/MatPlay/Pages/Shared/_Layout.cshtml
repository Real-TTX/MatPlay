@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // Eine Seite kann setzen: Title (Überschrift + letzter Krümel), Description (eine Zeile unter dem Titel),
    // Breadcrumb (Liste aus Text/Url, letzter Eintrag ohne Url), NoHeading (Seite zeichnet ihren Kopf selbst),
    // Width ("narrow" | "wide") und Section TopActions (Icon-Buttons rechts in der Kopfleiste).
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string;
    var breadcrumb = ViewData["Breadcrumb"] as List<(string Text, string? Url)>;
    var showHeading = ViewData["NoHeading"] is not true && !string.IsNullOrEmpty(title);
    var width = ViewData["Width"] as string;
}
<!DOCTYPE html>
<html lang="de" data-app="matplay" @Ui.ToolkitTexts>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(string.IsNullOrEmpty(title) ? "MatPlay" : title + " · MatPlay")</title>
    <script src="~/matui/matui.boot.js"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_PwaHead" />
</head>
<body>
    <a class="mat-skip" href="#main">Zum Inhalt springen</a>
    @Ui.Sprite(Env.WebRootPath)

    <div class="mat-app">
        <partial name="_Nav" />

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="Menü umschalten" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="Brotkrumen">
                    <ol>
                        <li><a href="/" aria-label="Start">@Ui.Icon("home")</a></li>
                        @if (breadcrumb is { Count: > 0 })
                        {
                            @foreach (var (text, url) in breadcrumb)
                            {
                                if (url != null)
                                {
                                    <li><a href="@url">@text</a></li>
                                }
                                else
                                {
                                    <li aria-current="page">@text</li>
                                }
                            }
                        }
                        else
                        {
                            <li aria-current="page">@(string.IsNullOrEmpty(title) ? "MatPlay" : title)</li>
                        }
                    </ol>
                </nav>
                @if (IsSectionDefined("TopActions"))
                {
                    <div class="mat-topbar__actions">@await RenderSectionAsync("TopActions", required: false)</div>
                }
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                @if (showHeading)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(description))
                            {
                                <p class="mat-page__sub">@description</p>
                            }
                        </div>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
