@page "/players/edit/{id:long}"
@model MatPlay.Pages.Players.EditModel
@using MatPlay.Pages.Shared.Controls
@{
    ViewData["Title"] = "Spieler bearbeiten";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Spieler", "/players"), (Model.Target?.Name ?? "Bearbeiten", null) };
}

@if (Model.Error != null)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form" novalidate>
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" for="Name">Name <span class="mat-req" aria-hidden="true">*</span></label>
                    <input asp-for="Name" class="mat-input" required maxlength="40" data-msg-required="Der Name darf nicht leer sein." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Code">Kürzel <span class="mat-req" aria-hidden="true">*</span></label>
                    <input asp-for="Code" class="mat-input" required maxlength="4" data-msg-required="Das Kürzel braucht 1 bis 4 Zeichen." />
                    <span class="mat-error" aria-live="polite"></span>
                    <span class="mat-hint">Automatisch vergeben, hier änderbar.</span>
                </div>
            </div>
            <div class="mat-field">
                <label class="mat-label" for="Color">Farbe</label>
                <div class="mat-picker" data-picker="colour" data-swatches="@string.Join(",", SavedPlayerService.Palette)">
                    <input class="mat-picker__input" id="Color" name="Color" value="@Model.Color" />
                </div>
            </div>
            <partial name="Controls/_FormActions" model="@(new FormActionsModel
            {
                BackUrl = "/players",
                DeleteHandler = "Delete",
                DeleteConfirm = "Diesen Spieler wirklich löschen? Die Spiel-Historie bleibt erhalten.",
            })" />
        </form>
        <partial name="Controls/_DeleteForm" model="@(new FormActionsModel { DeleteHandler = "Delete" })" />
    </div>
</div>

<section class="mat-stack" aria-labelledby="history-title">
    <h2 class="mp-h2" id="history-title">Gespielte Spiele (@Model.Games.Count)</h2>
    @if (Model.Games.Count == 0)
    {
        <p class="mat-muted">Noch keine Spiele mit diesem Spieler.</p>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Spiele von @Model.Target?.Name</caption>
                <thead>
                <tr>
                    <th scope="col">Spiel</th>
                    <th scope="col" class="mat-hide-sm">Modul</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="mat-hide-sm">Zuletzt aktiv</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var game in Model.Games)
                {
                    var module = ModuleRegistry.GetModule(game.ModuleKey);
                    var running = game.Status == GameStatus.Running;
                    <tr>
                        <td data-label="Spiel"><div class="mat-table__name"><span class="mp-inline-cover" aria-hidden="true">@ModuleRegistry.IconFor(game.ModuleKey, game.PresetKey)</span><a href="/play/@game.ShareToken">@game.Name</a></div></td>
                        <td data-label="Modul" class="mat-hide-sm">@(module?.Name ?? game.ModuleKey)</td>
                        <td data-label="Status"><span class="mat-pill @(running ? "mat-pill--ok" : "mat-pill--plain")">@(running ? "Läuft" : "Beendet")</span></td>
                        <td data-label="Zuletzt aktiv" class="mat-hide-sm">@game.UpdateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
