@page "/games/create"
@model MatPlay.Pages.Games.CreateModel
@using MatPlay.Pages.Shared.Controls
@{
    ViewData["Title"] = "Neues Spiel";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Meine Spiele", "/games"), ("Neues Spiel", "/games/new"), ("Einstellungen", null) };
    var players = Model.Players.Count > 0 ? Model.Players : new List<string> { "" };
}

@if (Model.Error != null)
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<form method="post" class="mat-form" id="createForm" novalidate data-presets="@Model.PresetsJson">
    <div class="mat-card">
        <div class="mat-card__body mat-stack">
            <div class="mat-field">
                <label class="mat-label" for="Preset">Preset</label>
                <div class="mat-picker" data-picker="select" data-search data-clearable data-placeholder="Eigenes Spiel (kein Preset)">
                    <input class="mat-picker__input" id="Preset" name="Preset" value="@Model.Preset" />
                    <div class="mat-picker__options" hidden>
                        @foreach (var preset in ModuleRegistry.Presets)
                        {
                            <button type="button" class="mat-picker__option" data-value="@preset.Key">
                                <span class="mat-picker__text">
                                    <span class="mat-picker__name">@preset.Icon @preset.Name</span>
                                    <span class="mat-picker__desc">@preset.Description</span>
                                </span>
                            </button>
                        }
                    </div>
                </div>
                <span class="mat-hint">Übernimmt Modul und Einstellungen – eingetragene Spieler bleiben erhalten.</span>
            </div>

            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" for="Name">Name des Spiels <span class="mat-req" aria-hidden="true">*</span></label>
                    <input asp-for="Name" class="mat-input" placeholder="z.B. Spieleabend bei Max" required maxlength="80" data-msg-required="Bitte gib dem Spiel einen Namen." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ModuleKey">Spielmodul</label>
                    <select asp-for="ModuleKey" class="mat-select">
                        @foreach (var module in ModuleRegistry.Modules)
                        {
                            <option value="@module.Key">@module.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Spieler</h2></div>
        <div class="mat-card__body mat-stack">
            @if (Model.SavedPlayerList.Count > 0)
            {
                <div class="mat-stack mat-stack--sm">
                    <span class="mat-hint">Gespeicherte Spieler antippen:</span>
                    <div class="mp-chip-row" id="savedPlayerChips">
                        @foreach (var saved in Model.SavedPlayerList)
                        {
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm mp-chip" data-player="@saved.Name">
                                <span class="mat-dot" data-colour="@saved.Color" aria-hidden="true"></span><span>@saved.Name</span>
                            </button>
                        }
                    </div>
                </div>
                <datalist id="savedPlayersList">
                    @foreach (var saved in Model.SavedPlayerList)
                    {
                        <option value="@saved.Name"></option>
                    }
                </datalist>
            }

            <div id="playerList" class="mat-stack mat-stack--sm">
                @foreach (var player in players)
                {
                    <div class="mp-player-row">
                        <input type="text" class="mat-input" name="Players" value="@player" placeholder="Spielername" maxlength="40" list="savedPlayersList" aria-label="Spielername" />
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon remove-player" title="Entfernen" aria-label="Spieler entfernen">@Ui.Icon("x")</button>
                    </div>
                }
            </div>
            <div>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="addPlayer">@Ui.Icon("plus")<span>Spieler hinzufügen</span></button>
            </div>

            <label class="mat-check">
                <input asp-for="SavePlayers" type="checkbox" />
                <span class="mat-check__text">Neue Spieler automatisch speichern (unter „Spieler“ verwaltbar)</span>
            </label>
        </div>
    </div>

    <div class="mat-card" data-show-if="ModuleKey" data-show-value="qwixx">
        <div class="mat-card__head"><h2 class="mat-card__title">Qwixx-Variante</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-field">
                <label class="mat-label" for="QwixxVariant">Block</label>
                <select asp-for="QwixxVariant" class="mat-select">
                    @foreach (var (key, name) in QwixxPad.Variants)
                    {
                        <option value="@key">@name</option>
                    }
                </select>
                <span class="mat-hint">Gemixxt-Blöcke werden für jedes Spiel neu ausgewürfelt – nach den Regeln der Erweiterung „Qwixx gemixxt“.</span>
            </div>
        </div>
    </div>

    <div class="mat-card" data-show-if="ModuleKey" data-show-value="munchkin">
        <div class="mat-card__head"><h2 class="mat-card__title">Munchkin-Einstellungen</h2></div>
        <div class="mat-card__body">
            <label class="mat-check">
                <input asp-for="MunchkinTrackHealth" type="checkbox" />
                <span class="mat-check__text">Lebenspunkte mitzählen (Munchkin Quest – Start mit 4 Leben)</span>
            </label>
        </div>
    </div>

    <div class="mat-card" data-show-if="ModuleKey" data-show-value="counter">
        <div class="mat-card__head"><h2 class="mat-card__title">Zähler-Einstellungen</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" for="StartScore">Startpunkte</label>
                    <input asp-for="StartScore" type="number" class="mat-input" inputmode="numeric" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Step">Schrittweite (+/−)</label>
                    <input asp-for="Step" type="number" class="mat-input" min="1" inputmode="numeric" />
                </div>
            </div>
            <label class="mat-check">
                <input asp-for="HasTarget" type="checkbox" />
                <span class="mat-check__text">Zielpunktzahl festlegen</span>
            </label>
            <div class="mat-field" data-show-if="#HasTarget" data-show-value="true">
                <label class="mat-label" for="TargetScore">Zielpunktzahl</label>
                <input asp-for="TargetScore" type="number" class="mat-input" inputmode="numeric" />
            </div>
            <label class="mat-check">
                <input asp-for="LowestWins" type="checkbox" />
                <span class="mat-check__text">Wenigste Punkte gewinnen</span>
            </label>
            <label class="mat-check">
                <input asp-for="AllowNegative" type="checkbox" />
                <span class="mat-check__text">Negative Punkte erlauben</span>
            </label>
            <label class="mat-check">
                <input asp-for="UseRounds" type="checkbox" />
                <span class="mat-check__text">In Runden zählen</span>
            </label>
            <label class="mat-check" data-show-if="#UseRounds" data-show-value="true">
                <input asp-for="SubtractRounds" type="checkbox" />
                <span class="mat-check__text">Rundenpunkte abziehen statt addieren (z.B. Darts)</span>
            </label>
        </div>
    </div>

    <partial name="Controls/_FormActions" model="@(new FormActionsModel { SaveText = "Spiel starten", SaveIcon = "play", BackUrl = "/games/new" })" />
</form>

@section Scripts {
    <script src="~/js/games-create.js" asp-append-version="true"></script>
}
