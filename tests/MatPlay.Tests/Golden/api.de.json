{
  "contract": 1,
  "app": {
    "id": "matplay",
    "name": "MatPlay",
    "description": "Punkte zählen am Spieleabend",
    "version": "<version>",
    "icon": "/icons/favicon.svg",
    "accent": "#00819b",
    "home": "/"
  },
  "auth": {
    "apiKey": true
  },
  "pages": [
    {
      "id": "overview",
      "label": "Übersicht",
      "icon": "dashboard",
      "sections": [
        {
          "kind": "tiles",
          "items": [
            "games",
            "runningGames",
            "gamesLast30Days",
            "players",
            "accounts",
            "topGame",
            "lastGameNight"
          ]
        },
        {
          "kind": "actions",
          "items": [
            "openUsers",
            "openSettings",
            "cleanupSessions"
          ]
        }
      ]
    },
    {
      "id": "settings",
      "label": "Einstellungen",
      "icon": "settings",
      "sections": [
        {
          "kind": "form",
          "items": [
            "allowRegistration"
          ],
          "label": "Benutzer"
        },
        {
          "kind": "form",
          "items": [
            "playerCodeLength"
          ],
          "label": "Spielerprofile"
        }
      ]
    }
  ],
  "state": [
    {
      "key": "games",
      "label": "Spiele",
      "widget": "number",
      "icon": "gamepad"
    },
    {
      "key": "runningGames",
      "label": "Laufende Spiele",
      "widget": "number",
      "icon": "play"
    },
    {
      "key": "gamesLast30Days",
      "label": "Spiele der letzten 30 Tage",
      "widget": "number",
      "icon": "calendar"
    },
    {
      "key": "players",
      "label": "Spielerprofile",
      "widget": "number",
      "icon": "users"
    },
    {
      "key": "accounts",
      "label": "Benutzerkonten",
      "widget": "number",
      "icon": "user"
    },
    {
      "key": "topGame",
      "label": "Meistgespieltes Spiel",
      "widget": "text",
      "icon": "star"
    },
    {
      "key": "lastGameNight",
      "label": "Letzter Spieleabend",
      "widget": "time",
      "icon": "clock"
    }
  ],
  "configure": [
    {
      "key": "allowRegistration",
      "label": "Selbst-Registrierung erlauben",
      "type": "bool",
      "hint": "Aus: Konten legt nur die Administration an. Spielen als Gast geht immer."
    },
    {
      "key": "playerCodeLength",
      "label": "Länge der automatischen Kürzel",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 4,
      "hint": "Gilt für neu angelegte Spieler; bestehende Kürzel bleiben."
    }
  ],
  "actions": [
    {
      "id": "openUsers",
      "label": "Benutzer verwalten",
      "icon": "users",
      "kind": "link",
      "url": "/admin/users"
    },
    {
      "id": "openSettings",
      "label": "Alle Einstellungen",
      "icon": "settings",
      "kind": "link",
      "url": "/admin/settings"
    },
    {
      "id": "cleanupSessions",
      "label": "Abgelaufene Sitzungen löschen",
      "icon": "broom",
      "kind": "post"
    }
  ],
  "provides": [],
  "consumes": [],
  "roles": [
    {
      "key": "admin",
      "label": "Administrator"
    },
    {
      "key": "user",
      "label": "Benutzer"
    }
  ],
  "endpoints": [
    "/api/health",
    "/api/state",
    "/api/configure",
    "/api/actions"
  ]
}
